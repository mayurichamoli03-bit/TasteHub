# MongoDB Atlas connection string (or MONGODB_URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/tastehub?retryWrites=true&w=majority

# Target database name (defaults to tastehub if omitted)
DB_NAME=tastehub

# JWT Signing Secret (generate a strong random secret)
JWT_SECRET=tastehub_prod_jwt_secret_key_change_me_in_production

# Allowed frontend origin(s) for CORS (comma-separated or * for all)
FRONTEND_URL=https://taste-hub-aoz5.vercel.app,http://localhost:5500,http://localhost:3000

# Backend Port (local development)
PORT=5000
